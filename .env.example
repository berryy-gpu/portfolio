# The site's canonical absolute URL — used for metadataBase, the sitemap,
# robots.txt, and JSON-LD/Open Graph image URLs. Falls back to
# http://localhost:3000 if unset, so it's only required once a production
# domain exists.
NEXT_PUBLIC_SITE_URL=

# Resend (https://resend.com) — used by src/app/api/contact/route.ts to
# send the contact form's notification email. Required in production;
# without it, the API route returns a 500 and the form shows an error
# state (it fails safely, it just won't send).
RESEND_API_KEY=

# Optional. Must be a sender on a domain verified in Resend. If unset,
# falls back to Resend's onboarding@resend.dev sandbox sender, which
# works without domain verification but is meant for testing, not
# production sending volume.
RESEND_FROM_EMAIL="Portfolio Contact <onboarding@resend.dev>"
