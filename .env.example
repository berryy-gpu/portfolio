# The site's canonical absolute URL — used for metadataBase, the sitemap,
# robots.txt, and JSON-LD/Open Graph image URLs. Falls back to
# http://localhost:3000 if unset, so it's only required once a production
# domain exists.
NEXT_PUBLIC_SITE_URL=

# Plain SMTP (via Nodemailer, src/lib/mailer.ts) — used by
# src/app/api/contact/route.ts to send the contact form's notification
# email. All five are required in production; without any one of them,
# getMailer() returns null and the API route returns a 500 (the form
# shows an error state — it fails safely, it just won't send). The
# outgoing "from" address is always SMTP_USER itself (many providers,
# Gmail included, reject a from that doesn't match the authenticated
# account), so there's no separate configurable sender address here.
#
# Gmail: SMTP_USER is the full Gmail address; SMTP_PASSWORD must be a
# Google App Password (requires 2-Step Verification to be enabled first),
# NOT the normal account password — generate one at
# https://myaccount.google.com/apppasswords.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
